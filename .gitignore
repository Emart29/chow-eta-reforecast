# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# Data & model artifacts (regenerated by the pipeline)
data/*.parquet
data/*.csv
models/*.pkl
models/*.joblib
# Except the serving bundle, committed so the API image deploys without training.
!models/serving_bundle.joblib
reports/figures/*.png
reports/*.json
reports/*.html
reports/*.csv

# Keep the small precomputed artifacts the dashboard reads, so it runs on a fresh
# clone and on Streamlit Cloud without first running the training pipeline.
!reports/comparison.json
!reports/risk_metrics.json
!reports/drift_metrics.json
!reports/risk_examples.csv

# Tooling
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.DS_Store

# Keep folder structure
!data/.gitkeep
!reports/figures/.gitkeep
